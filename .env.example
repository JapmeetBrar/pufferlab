# Server-only settings. Copy to .env and keep the real key out of git and shell history.
# Required by `uv run pufferlab dataset ingest-tiny` and live search.
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
PUFFERLAB_ENVIRONMENT=development
PUFFERLAB_DATA_DIR=data
PUFFERLAB_FIXTURE_DIR=fixtures/tiny-corpus
# Copy the exact assignment printed by a successful ingest command here.
PUFFERLAB_SEARCH_NAMESPACE=
PUFFERLAB_CORS_ORIGINS=http://localhost:5173
